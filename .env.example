# Copy this file to .env and fill it in. .env is git-ignored.
# Any platform you leave blank simply fails with a clear message instead of
# crashing the whole run.

# Platforms posted to by default (blank = every platform configured below).
SPP_PLATFORMS=

# --- Flickr -------------------------------------------------------------
# https://www.flickr.com/services/apps/create/apply/
FLICKR_API_KEY=
FLICKR_API_SECRET=

# --- Instagram ----------------------------------------------------------
# Plain account credentials: instagrapi drives the private mobile API, there
# is no official key for personal accounts.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# --- Bluesky -----------------------------------------------------------
# Your handle (e.g. someone.bsky.social) and an *app password*, created in
# Settings > Privacy and security > App passwords. Never your account password.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
