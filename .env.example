# Copy this file to .env and fill it in. .env is git-ignored.
# Any platform you leave blank simply fails with a clear message instead of
# crashing the whole run.

# Platforms posted to by default (blank = every platform configured below).
SPP_PLATFORMS=

# Language of your captions, declared to the platforms (defaults to fr).
SPP_LANGS=

# --- Flickr -------------------------------------------------------------
# https://www.flickr.com/services/apps/create/apply/
FLICKR_API_KEY=
FLICKR_API_SECRET=

# --- Instagram ----------------------------------------------------------
# Plain account credentials: instagrapi drives the private mobile API, there
# is no official key for personal accounts.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
# If Instagram answers the password login with ChallengeRequired, put the
# sessionid cookie of a browser already logged into the account here and it
# is used instead: Firefox > F12 > Storage > Cookies > instagram.com >
# sessionid. It is a credential, it expires, and logging that browser out
# revokes it. Same machine and connection as the browser.
INSTAGRAM_SESSIONID=

# --- Bluesky -----------------------------------------------------------
# Your handle (e.g. someone.bsky.social) and an *app password*, created in
# Settings > Privacy and security > App passwords. Never your account password.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
